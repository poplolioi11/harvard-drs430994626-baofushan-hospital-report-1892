            1535
          ],
          "text": "余",
          "layer": "printed-small-inline",
          "placement": "inline"
        }
      ]
    },
    {
      "image": 8,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page8-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "5a733b765ff939a34bc1f4f916f32a05c6f33b712fc4de190cd01af2366fecac",
      "units": [
        {
          "id": "p08-c01",
          "kind": "body",
          "text": "萬六千人茲將外來就治者諸症按類臚陳於左　部症"
        },
        {
          "id": "p08-c02",
          "kind": "body",
          "text": "六百六十人　耳諸症一百零四人　肌肉症一千八百"
        },
        {
          "id": "p08-c03",
          "kind": "body",
          "text": "三十七人　養生路諸症八百三十人　核諸症一百二"
        },
        {
          "id": "p08-c04",
          "kind": "body",
          "text": "十三人　骨並骨節症一百一十七人　鼻諸症三十五"
        },
        {
          "id": "p08-c05",
          "kind": "body",
          "text": "人　腦筋症七十五人　眼等症四百五十四人　呼吸"
        },
        {
          "id": "p08-c06",
          "kind": "body",
          "text": "症一百四十人　陰陽諸症二百四十人　雜症五百二"
        },
        {
          "id": "p08-c07",
          "kind": "body",
          "text": "十六人統計五千一百四十人"
        },
        {
          "id": "p08-c08",
          "kind": "body",
          "text": "又將全年住館要症開列于左"
        },
        {
          "id": "p08-c09",
          "kind": "heading",
          "text": "眼症"
        }
      ],
      "reviewed_change_ids": [
        "p08-c04"
      ]
    },
    {
      "image": 9,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page9-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "e594c2669f0cbb68f427c10c60031267595aa298361dc77fbbdbfe16ccacd53f",
      "units": [
        {
          "id": "p09-c01",
          "kind": "body",
          "text": "板睛九人　瞳人縮小五人　作假瞳人三人　變質三"
        },
        {
          "id": "p09-c02",
          "kind": "body",
          "text": "人　睛衣舊炎十二人　新炎五人　腦筋壞二人　明"
        },
        {
          "id": "p09-c03",
          "kind": "body",
          "text": "衣傷破二人　眼簾炎一人　眼球全壞三人　倒插十"
        },
        {
          "id": "p09-c04",
          "kind": "body",
          "text": "四人　白雲四人"
        },
        {
          "id": "p09-c05",
          "kind": "heading",
          "text": "瘋濕症"
        },
        {
          "id": "p09-c06",
          "kind": "body",
          "text": "舊瘋七人　新風四人　花柳風三人　節風二人"
        },
        {
          "id": "p09-c07",
          "kind": "heading",
          "text": "陰陽症"
        },
        {
          "id": "p09-c08",
          "kind": "body",
          "text": "內痔十人　外痔八人　漏管三十二人　由白濁溺管"
        },
        {
          "id": "p09-c09",
          "kind": "body",
          "text": "縮小三人　跌傷溺管縮小二人　包頭便十二人　硬"
        },
        {
          "id": "p09-c10",
          "kind": "running",
          "text": "保福山聖教醫館畧述"
        },
        {
          "id": "p09-c11",
          "kind": "folio",
          "text": "三"
        }
      ]
    },
    {
      "image": 10,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page10-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "8f7a042c004b015cb9ed0acf8de6e73646c9cf4806209563cdb3c4bdbf2060a9",
      "units": [
        {
          "id": "p10-c01",
          "kind": "body",
          "text": "生加十六人　軟生加十八人　魚口五人　卵子炎四"
        },
        {
          "id": "p10-c02",
          "kind": "body",
          "text": "人　水疝五人　男淫瘡二人　肌門內皮爛一人　小"
        },
        {
          "id": "p10-c03",
          "kind": "body",
          "text": "便捲皮一人　小便口肉瘤一人　象腎一人　腎囊花"
        },
        {
          "id": "p10-c04",
          "kind": "body",
          "text": "柳爛四人　下消一人"
        },
        {
          "id": "p10-c05",
          "kind": "heading",
          "text": "骨節症"
        },
        {
          "id": "p10-c06",
          "kind": "body",
          "text": "扯敗骨三人　膕處壞骨三人　牙牀敗骨四人　牙牀"
        },
        {
          "id": "p10-c07",
          "kind": "body",
          "text": "爛管一人　背骨灣斜一人　臂骨出輪一人　扯甲炎"
        },
        {
          "id": "p10-c08",
          "kind": "body",
          "text": "三人　接肘骨一人　脊柱骨刀傷一人　膝處筋縮一"
        },
        {
          "id": "p10-c09",
          "kind": "body",
          "text": "人"
        }
      ],
      "reviewed_change_ids": [
        "p10-c02",
        "p10-c06"
      ]
    },
    {
      "image": 11,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page11-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "88945adf0547d6ff16a7819b324d2b7ab9aad8e2f482b1a44ae6a6b0ede9114a",
      "units": [
        {
          "id": "p11-c01",
          "kind": "heading",
          "text": "受傷症"
        },
        {
          "id": "p11-c02",
          "kind": "body",
          "text": "炮子傷五人　犬咬五人　蛇咬二人　湯火傷一人"
        },
        {
          "id": "p11-c03",
          "kind": "body",
          "text": "人咬手扯敗骨一人　火藥傷一人　膝節跌破二人"
        },
        {
          "id": "p11-c04",
          "kind": "heading",
          "text": "養生症"
        },
        {
          "id": "p11-c05",
          "kind": "body",
          "text": "缺唇四人　胃痛五人　血衰五人　蠱脹二人　全體"
        },
        {
          "id": "p11-c06",
          "kind": "body",
          "text": "虛腫二人　救服鴉片毒一人　戒烟二人　痢症一人"
        },
        {
          "id": "p11-c07",
          "kind": "body",
          "text": "熱症四人"
        },
        {
          "id": "p11-c08",
          "kind": "heading",
          "text": "腦筋症"
        },
        {
          "id": "p11-c09",
          "kind": "body",
          "text": "偏瘋二人　戰瘋一人　受鉛毒瘋一人　痲瘋二人"
        },
        {
          "id": "p11-c10",
          "kind": "running",
          "text": "保福山聖教醫館畧述"
        },
        {
          "id": "p11-c11",
          "kind": "folio",
          "text": "四"
        }
      ]
    },
    {
      "image": 12,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page12-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "c202ba42fabd97086d00af07ea06907306059b266331e76b062cb1679254a556",
      "units": [
        {
          "id": "p12-c01",
          "kind": "body",
          "text": "爛痲瘋四人"
        },
        {
          "id": "p12-c02",
          "kind": "heading",
          "text": "花柳症"
        },
        {
          "id": "p12-c03",
          "kind": "body",
          "text": "楊梅瘡二人　爛骨五人　爛管四人　爛皮十人"
        },
        {
          "id": "p12-c04",
          "kind": "heading",
          "text": "瘤症"
        },
        {
          "id": "p12-c05",
          "kind": "body",
          "text": "肉瘤五人　爛瘤三人　手　毒瘤三人　膝骨瘤一人"
        },
        {
          "id": "p12-c06",
          "kind": "body",
          "text": "腎囊毒瘤一人"
        },
        {
          "id": "p12-c07",
          "kind": "heading",
          "text": "呼吸症"
        },
        {
          "id": "p12-c08",
          "kind": "body",
          "text": "舊嗽四人　肺勞二人"
        },
        {
          "id": "p12-c09",
          "kind": "heading",
          "text": "皮膚症"
        }
      ]
    },
    {
      "image": 13,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page13-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "b4d1922e3390b80ef996ccc2365b87541bd650037c19277c5844774389d84a50",
      "units": [
        {
          "id": "p13-c01",
          "kind": "body",
          "text": "爛皮二十八人　大沙蹄一人　水螆九人　耳內瘡癤"
        },
        {
          "id": "p13-c02",
          "kind": "body",
          "text": "二人"
        },
        {
          "id": "p13-c03",
          "kind": "heading",
          "text": "肌肉症"
        },
        {
          "id": "p13-c04",
          "kind": "body",
          "text": "小膿瘡七人　大腿深膿瘡六人　爛管三十一人"
        },
        {
          "id": "p13-c05",
          "kind": "heading",
          "text": "核症"
        },
        {
          "id": "p13-c06",
          "kind": "body",
          "text": "核炎三人"
        },
        {
          "id": "p13-c07",
          "kind": "heading",
          "text": "鋸症"
        },
        {
          "id": "p13-c08",
          "kind": "body",
          "text": "鋸股一人　鋸手三人　以上等症共計三百九十八人"
        },
        {
          "id": "p13-c09",
          "kind": "body",
          "text": "又將諸症中分類開列"
        },
        {
          "id": "p13-c10",
          "kind": "running",
          "text": "保福山聖教醫館畧述"
        },
        {
          "id": "p13-c11",
          "kind": "folio",
          "text": "五"
        }
      ],
      "reviewed_change_ids": [
        "p13-c08"
      ]
    },
    {
      "image": 14,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page14-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "cc54464619b59a4a85e348fc902c8736096176c142bf5b49f5a9021e4fcbdd98",
      "units": [
        {
          "id": "p14-c01",
          "kind": "body",
          "text": "士子八人　農夫一百五十人　作工五十四人　作商"
        },
        {
          "id": "p14-c02",
          "kind": "body",
          "text": "四十六人　哨官三人　兵丁九十六人　幕賓一人"
        },
        {
          "id": "p14-c03",
          "kind": "body",
          "text": "隨官三人　差役七人　討魚十六人　行舟十四人"
        },
        {
          "id": "p14-c04",
          "kind": "body",
          "text": "內全愈二百九十九人　小愈九十五人　照常四人"
        },
        {
          "id": "p14-c05",
          "kind": "heading",
          "text": "割諸症開列於左"
        },
        {
          "id": "p14-c06",
          "kind": "body",
          "text": "放膿瘡一百二十一人　割指趾十三人　鋸手肘一人"
        },
        {
          "id": "p14-c07",
          "kind": "body",
          "text": "鋸手臂二人　鋸腳一人　割陽物毒瘤一人　割瘤"
        },
        {
          "id": "p14-c08",
          "kind": "body",
          "text": "四十八人　割包頭便二十九人　透溺管險症八人"
        },
        {
          "id": "p14-c09",
          "kind": "body",
          "text": "割象腎囊一人　割眼等症四十三人　取眼球一人"
        }
      ]
    },
    {
      "image": 15,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page15-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "c5222af6047428672071a3172c33dca39528a3991ce562eca20b394c006400ea",
      "units": [
        {
          "id": "p15-c01",
          "kind": "body",
          "text": "療內外痔四十五人　取蛀牙四百一十八人　割漏管"
        },
        {
          "id": "p15-c02",
          "kind": "body",
          "text": "三十三人　割被柴竹刺傷症六人　接骨二人　補缺"
        },
        {
          "id": "p15-c03",
          "kind": "body",
          "text": "唇六人　補缺耳一人　放水泡四人　割無肌門一人"
        },
        {
          "id": "p15-c04",
          "kind": "body",
          "text": "箝敗骨十四人　開肌下管三人　拔壞甲八人　綁"
        },
        {
          "id": "p15-c05",
          "kind": "body",
          "text": "縛血管五人　開小孩無肌門一人　放蠱脹二人　收"
        },
        {
          "id": "p15-c06",
          "kind": "body",
          "text": "脫肛四人　取石淋一人　統計八百二十三人"
        },
        {
          "id": "p15-c07",
          "kind": "body",
          "text": "以上諸割症中有奇症者會顯西法之良如一炮首為放"
        },
        {
          "id": "p15-c08",
          "kind": "body",
          "text": "炮自悞轟裂手腕割鋸腐腕俾不至毒移肱臂生命得以"
        },
        {
          "id": "p15-c09",
          "kind": "body",
          "text": "保全又一人臀生一大瘤割下稱之重四十一兩割眼中"
        },
        {
          "id": "p15-c10",
          "kind": "running",
          "text": "保福山聖教醫館畧述"
        },
        {
          "id": "p15-c11",
          "kind": "folio",
          "text": "六"
        }
      ],
      "reviewed_change_ids": [
        "p15-c03",
        "p15-c04",
        "p15-c05"
      ]
    },
    {
      "image": 16,
      "url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf/page16-1920px-Harvard_drs_430994626_%E4%BF%9D%E7%A6%8F%E5%B1%B1%E8%81%96%E6%95%99%E9%86%AB%E9%A4%A8%E7%95%A5%E8%BF%B0.pdf.jpg",
      "source_sha256": "2134edbb3459996c942039d72add4bd9a160fbb26756d0e2434220010eb485e8",
      "units": [
        {
          "id": "p16-c01",
          "kind": "body",
          "text": "間多因眼患倒睫非割之則致瞽所記綁縛血管皆係要"
        },
        {
          "id": "p16-c02",
          "kind": "body",
          "text": "症其餘輕症毋庸詳述尤幸者本年並無住館逝世者惟"
        },
        {
          "id": "p16-c03",
          "kind": "body",
          "text": "有一流丐在館門之外奄奄將斃余見之一時惻隱收入"
        },
        {
          "id": "p16-c04",
          "kind": "body",
          "text": "館中施治無何竟為異物隨卽備材瘞埋又以上未載者"
        },
        {
          "id": "p16-c05",
          "kind": "body",
          "text": "本年間有人延余往救難產者數次惜時太過遲母活而"
        },
        {
          "id": "p16-c06",
          "kind": "body",
          "text": "子斃有時太遲或母子不能俱保但救產如救兵星速為"
        },
        {
          "id": "p16-c07",
          "kind": "body",
          "text": "妙倘早延余庶有生氣矣"
        },
        {
          "id": "p16-c08",
          "kind": "body",
          "text": "茲蒙"
        },
        {
          "id": "p16-c09",
          "kind": "heading",
          "text": "諸憲樂捐銀欵開列于左"
        }
      ],
